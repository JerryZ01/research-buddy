# Research Buddy 环境变量

# LLM - 通过中转站 API
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.world-cup.asia/v1
OPENAI_MODEL=gpt-4o

# 视觉模型选图（可选）：配置后文章会从搜索结果中挑选相关插图并生成 alt 文本。
# 留空则图片功能整体关闭（行为与无图版本一致）。需使用支持 vision 的模型，
# 如 v4-flash-vision-exp。图片下载只在选图内部进行（不落盘），文章引用原图 URL。
# VISION_MODEL=v4-flash-vision-exp

# 搜索 - Tavily API（免费 1000 次/月，https://tavily.com 注册）
TAVILY_API_KEY=tvly-xxx

# Langfuse (https://cloud.langfuse.com 注册免费版，或自托管，可选)
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse 请求超时（秒）。SDK 默认只有 5 秒，跨境访问 cloud.langfuse.com
# 常见 "Failed to export span batch ... Read timed out"，trace 会被静默丢弃。
# LANGFUSE_TIMEOUT=20
# Prompt 缓存 TTL（秒）。SDK 默认 60，意味着每分钟一次冷取会阻塞节点。
# LANGFUSE_PROMPT_CACHE_DEFAULT_TTL_SECONDS=600
# 完全关闭链路上报（本地调试或网络不通时最干净的做法）：
# LANGFUSE_TRACING_ENABLED=false

# 数据目录（SQLite + ChromaDB 持久化，默认 ./data）
# DATA_DIR=./data

# 向量检索 embedding 后端（默认 default）
#   default               ChromaDB 内置 all-MiniLM-L6-v2，零额外依赖，英文为主，中文召回偏低
#   sentence-transformers 本地多语言模型，中文检索质量好；需先 uv sync --extra multilingual（会拉入 torch）
#   openai                走上面的 OPENAI_API_BASE 调 /embeddings；中转站不一定支持
# 后端不可用时会打 WARNING 并降级到 default，不会静默切换。
# 切换后端后已有向量库不能混用：要么改回原模型，要么删掉 data/chroma_db 重建。
# EMBEDDING_BACKEND=default
# EMBEDDING_MODEL=

# 研究预算与证据阈值
MAX_SEARCH_RESULTS=5
MAX_SEARCH_ROUNDS=4
# 累计补搜查询预算（初始轮基础搜索不计入，避免双语扩展一轮就耗尽预算）
MAX_TOTAL_QUERIES=30
# 文末参考文献最多展示条数（LLM 从全部来源中筛选核心子集）
MAX_REFERENCES=8
# 单篇文章插图数量上限（想要图更多调大，更克制调小）
MAX_IMAGES_IN_ARTICLE=8
MAX_REFLECTION_ROUNDS=2
MIN_EVIDENCE_COVERAGE=0.75
MIN_DISTINCT_DOMAINS=2
MIN_RESULTS_PER_SUB_QUESTION=2
MIN_SEARCH_CONTENT_LENGTH=80

# 通知 Webhook（可选，支持企业微信/钉钉/Telegram 机器人）
# NOTIFICATION_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
