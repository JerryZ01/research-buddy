# Research Buddy 环境变量

# LLM - 通过中转站 API
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.world-cup.asia/v1
OPENAI_MODEL=gpt-4o

# 搜索 - Tavily API（免费 1000 次/月，https://tavily.com 注册）
TAVILY_API_KEY=tvly-xxx

# Langfuse (https://cloud.langfuse.com 注册免费版，或自托管，可选)
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=https://cloud.langfuse.com

# 数据目录（SQLite + ChromaDB 持久化，默认 ./data）
# DATA_DIR=./data

# 通知 Webhook（可选，支持企业微信/钉钉/Telegram 机器人）
# NOTIFICATION_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
